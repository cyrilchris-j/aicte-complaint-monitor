# ==============================================================================
# AICTE CaseSync — Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database, Auth & Storage (Frontend Safe)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard -> Project Settings -> API:
# - URL: https://<project-ref>.supabase.co
# - Anon Key: Public key (JWT token). NEVER put your service-role key here!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Assistive AI & Semantic Similarity
# ------------------------------------------------------------------------------
# API key for assistive classification, semantic embedding comparisons, and suggestions
VITE_AI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Citizen Dual OTP Verification Gateways
# ------------------------------------------------------------------------------
# Email OTP provider: 'simulation' | 'resend' | 'sendgrid' | 'postmark' | 'smtp'
# (Set to 'simulation' for instant on-screen demo OTP codes)
VITE_EMAIL_OTP_PROVIDER=simulation

# Mobile SMS OTP provider: 'simulation' | 'twilio' | 'fast2sms' | 'msg91' | 'cdac_sms'
# (Set to 'simulation' for instant on-screen demo OTP codes)
VITE_SMS_OTP_PROVIDER=simulation

# ------------------------------------------------------------------------------
# 4. Optional Backend / Supabase Edge Functions (Server-side only)
# ------------------------------------------------------------------------------
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/embeddings
AI_EMBEDDING_MODEL=text-embedding-3-small
